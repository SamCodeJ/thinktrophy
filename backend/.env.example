NODE_ENV=development
PORT=4000

# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:password@localhost:5432/thinktrophy
# Keep this small when Postgres shares the same 1-vCPU VPS as the API
DB_POOL_MAX=8

# Redis (shared cache + rate limits across PM2 workers). Optional in development.
# REDIS_URL=redis://127.0.0.1:6379
# REDIS_URL=redis://:password@127.0.0.1:6379/0

# JWT - Generate RSA-2048 key pair and base64 encode them
# openssl genrsa -out private.pem 2048
# openssl rsa -in private.pem -pubout -out public.pem
# cat private.pem | base64 -w 0  => JWT_PRIVATE_KEY
# cat public.pem  | base64 -w 0  => JWT_PUBLIC_KEY
JWT_PRIVATE_KEY=REPLACE_WITH_BASE64_ENCODED_RSA_PRIVATE_KEY
JWT_PUBLIC_KEY=REPLACE_WITH_BASE64_ENCODED_RSA_PUBLIC_KEY

# Refresh token secret (64+ random chars)
JWT_REFRESH_SECRET=REPLACE_WITH_LONG_RANDOM_STRING_64_CHARS

# Access token lifetime
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Session token lifetime (game session, in seconds)
GAME_SESSION_EXPIRY_SECONDS=110

# CORS allowed origin (comma-separated). Required in production — never use *.
CORS_ORIGIN=http://localhost:5173

# Payment gateway (Flutterwave)
PAYMENT_GATEWAY_KEY=sk_test_REPLACE_WITH_YOUR_KEY
FLW_SECRET_KEY=FLWSECK_TEST-REPLACE_WITH_YOUR_SECRET_KEY
FLW_SECRET_HASH=REPLACE_WITH_WEBHOOK_SECRET_HASH_FROM_FLUTTERWAVE_DASHBOARD
# Webhook URL to set in Flutterwave: ${APP_URL}/api/payment/webhook
# Flat fee deducted from each withdrawal (NGN). Withdrawal amount must be greater than this.
WITHDRAWAL_FEE=50

# Email / SMTP (Nodemailer)
# For Gmail: host=smtp.gmail.com, port=587, secure=false, use an App Password
# For Outlook: host=smtp-mail.outlook.com, port=587, secure=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=ThinkTrophy <your-email@gmail.com>

# Base URL of your backend (used in email verification links)
APP_URL=http://localhost:4000

# Public website (logo + links on the email verification success page)
WEB_URL=https://thinktrophy.com

# Platform defaults (can be overridden via admin settings)
MIN_STAKE=500.00
MAX_STAKE=5000.00
PAYOUT_PERFECT=2.0
PAYOUT_NINE=1.5
