{
  "expo": {
    "name": "ThinkTrophy",
    "slug": "thinktrophy",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "backgroundColor": "#000000",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.thinktrophy.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "ThinkTrophy uses Face ID for quick, secure login."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#151D23"
      },
      "package": "com.thinktrophy.app"
    },
    "plugins": [
      "expo-secure-store",
      "expo-local-authentication"
    ]
  }
}
